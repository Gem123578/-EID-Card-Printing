@model EIDCardPrint.Models.IssuedCardViewModel

@{
    ViewData["Title"] = "ReceivingCard";
    Layout = "_Layout";
}

<link href="~/css/ReceivedCard.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-0 animated-card p-4">

                <div class="card-body">

                    <h5 class="card-title mb-4 fw-bold text-primary">
                        Receiving Card
                    </h5>

                    <div class="mb-3">

                        <label for="qrInput"
                               class="form-label text-muted fw-semibold">
                            Read QR Code
                        </label>

                        <input type="text"
                               id="qrInput"
                               name="QRCode"
                               class="form-control form-control-lg animated-input"
                               placeholder="Scan QR Code..."
                               autocomplete="off"
                               autofocus />

                    </div>

                    <div id="message" class="mt-3"></div>

                </div>

            </div>

        </div>
    </div>
</div>

<script src="~/js/ReceivedCard.js"></script>