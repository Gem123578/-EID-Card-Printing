@model EIDCardPrint.Models.ApplicantListPageView

@{
    ViewData["Title"] = "Home";
    Layout = "_layout";
}

<link href="~/css/CardPrintingGridForm.css" rel="stylesheet" />
<link href="~/css/EIDCard.css" rel="stylesheet" />

<form asp-controller="Home" asp-action="CardPrintingGrid" id="cardSearchForm" method="get" class="p-4 border rounded-3 bg-white shadow-sm animated-search-card mb-4">
    <input type="hidden" name="isSearch" value="true" />

    <div class="row g-4 align-items-end">

        <div class="col-md-3">
            <label asp-for="SearchTerm" class="form-label text-color fw-bold">Name</label>
            <div class="input-group">
                <input asp-for="SearchTerm" id="SearchTerm" type="text" name="SearchTerm" class="form-control animated-input" placeholder="Name, UID သို့မဟုတ် QR ရိုက်ပါ..." />
            </div>
        </div>

        <div class="col-md-3">
            <label asp-for="OfficeCode" class="form-label text-color fw-bold">
                Office Stations
            </label>

            <select asp-for="OfficeCode"
                    id="officeSelect"
                    name="OfficeCode"
                    class="form-control animated-input">
                <option value="">-- Office Stations ရွေးပါ --</option>
            </select>
        </div>


        <div class="col-md-3">
            <label class="form-label text-color fw-bold">
                ရက်စွဲနှင့် အချိန် (Date)
            </label>

            <div class="input-group">

                <!-- Display Date -->
                <input id="dateRangeFilter"
                       type="text"
                       class="form-control animated-input"
                       placeholder="Date Range ရွေးပါ"
                       value="@(Model.FromDate.HasValue && Model.ToDate.HasValue ? $"{Model.FromDate:yyyy-MM-dd} - {Model.ToDate:yyyy-MM-dd}": "")" readonly />

                <!-- Clear Date -->
                <button type="button"
                        id="clearDateRange"
                        class="btn btn-outline-secondary @(Model.FromDate.HasValue && Model.ToDate.HasValue ? "show" : "")"
                        title="Clear Date">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>

            <!-- Selected Date Range Type -->
            <input type="hidden"
                   name="SelectedDate"
                   id="dateRangeType"
                   value="@Model.SelectedDate" />

            <!-- From Date -->
            <input type="hidden"
                   name="FromDate"
                   id="fromDate"
                   value="@Model.FromDate?.ToString("yyyy-MM-dd")" />

            <!-- To Date -->
            <input type="hidden"
                   name="ToDate"
                   id="toDate"
                   value="@Model.ToDate?.ToString("yyyy-MM-dd")" />

        </div>

        <div class="col-md-1">

            <label class="form-label text-color fw-bold">
                Status
            </label>

            <div class="printed-option">

                <input class="printed-radio"
                       type="radio"
                       name="IsPrinted"
                       id="isPrinted"
                       value="true"
                       @(Model.IsPrinted == true ? "checked" : "") />

                <label for="isPrinted" class="printed-label">
                    <span class="printed-radio-circle"></span>
                    <span>Printed</span>
                </label>

            </div>

        </div>
        <div class="col-md-2">
            <button class="btn btn-primary animated-btn" type="submit">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Search
            </button>
        </div>
        
    </div>
</form>

@if (Model.IsSearch)
{
    <div class="card shadow" id="tableContainer">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">

            <span id="txtTotalCount">
                Total : @Model.RecordCount
            </span>

            <button type="button"
                    id="generateXmlTopBtn"
                    class="btn btn-warning fw-bold"
                    onclick="submitPrint()">
                <i class="fa-solid fa-file-code me-1"></i>
                PRINT
            </button>

        </div>

        <div class="card-body p-3 border">

            <div class="table-responsive">

                <table id="cardTable"
                       class="table table-bordered table-hover mb-0 w-100">

                    <thead class="table-dark">

                        <tr>

                            <th style="width: 60px;" class="text-center">
                                <div class="header-checkbox-container">
                                    <label class="d-flex flex-column align-items-center mb-0"
                                           style="cursor:pointer;">

                                        <input type="checkbox"
                                               id="selectAllApplicants"
                                               class="form-check-input mb-1"
                                               style="cursor:pointer;" />

                                        <span class="all-text">
                                            ALL
                                        </span>

                                    </label>
                                </div>
                            </th>

                            <th>Applicant Number</th>

                            <th>Name</th>

                            <th>အမည်</th>

                            <th>NRC</th>

                            <th>Office Code</th>

                            <th id="colDynamicDate">
                                Printed Date
                            </th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var applicant in Model.Applicants)
                        {
                            <tr>

                                <td class="text-center">

                                    <input type="checkbox"
                                           class="form-check-input applicant-checkbox"
                                           value="@applicant.ApplicantId"
                                           data-applicant-id="@applicant.ApplicantId"
                                           data-uid="@applicant.UId"
                                           data-office-code="@Model.OfficeCode" />

                                </td>

                                <td>
                                    @applicant.ApplicantId
                                </td>

                                <td>
                                    @applicant.PersonNameEN
                                </td>

                                <td>
                                    @applicant.PersonNameMM
                                </td>

                                <td>
                                    @applicant.NRC
                                </td>

                                <td>
                                    @applicant.OfficeCode
                                </td>

                                <td>
                                    @(applicant.PrintedDate?.ToString("yyyy-MM-dd") ?? "-")
                                </td>

                                <td class="text-center">

                                    <a href="@Url.Action("EIDCardPrint", "CardPrint", new
                                       {
                                           applicantId = applicant.ApplicantId,
                                           uid = applicant.UId,
                                           officeCode = Model.OfficeCode
                                       })"
                               class="btn btn-sm btn-outline-success me-1 preview-card-btn"
                               data-applicant-id="@applicant.ApplicantId"
                               data-uid="@applicant.UId"
                               data-office-code="@Model.OfficeCode"
                               title="Print Preview">

                                        <i class="fa-solid fa-print me-1"></i>
                                        <span>Print Preview</span>

                                    </a>

                                </td>

                            </tr>
                                        }

                    </tbody>

                </table>

            </div>

            <input type="hidden"
                   id="hfCardJson"
                   value='[]' />

        </div>

    </div>
}
@if (Model.IsSearch)
{
    <div class="preview-overlay" id="cardPreviewModal">

        <div class="preview-modal">
            <div class="preview-modal-header">

                <div class="preview-title">
                    <i class="fa-solid fa-id-card me-2"></i>
                    EID Card Print Preview
                </div>

                <div class="preview-subtitle">
                    Electronic Identification Card
                </div>

            </div>


            <!-- Close -->
            <button type="button"
                    class="preview-close"
                    id="closeCardPreview">

                <i class="fa-solid fa-xmark"></i>

            </button>


            <!-- Card -->
            <div class="preview-card-content"
                 id="cardPreviewContent">

                <div class="preview-loading">

                    <div class="spinner-border text-primary"
                         role="status">
                    </div>

                    <span class="mt-2">
                        Loading Card...
                    </span>

                </div>

            </div>


            <!-- Action -->
            <div class="preview-actions">
                <button type="button"
                        class="preview-print-button"
                        id="previewGenerateXmlBtn">

                    <i class="fa-solid fa-print me-1"></i>
                    Print Card

                </button>
            </div>
            

        </div>

    </div>
}
@if (Model.IsSearch && Model.TotalPages > 1)
{
    <div class="pagination-wrapper d-flex justify-content-between align-items-center p-3 border-top">

        <div class="text-muted">
            Showing
            <strong>@Model.Applicants.Count</strong>
            of
            <strong>@Model.RecordCount</strong>
            records
        </div>

        <nav>
            <ul class="pagination mb-0">

                <!-- Previous -->
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("CardPrintingGrid","Home",
                                   new
                                   {
                                       isSearch = true,
                                       CurrentPageNumber = Model.CurrentPageNumber - 1,
                                       ApplicantPerPage = Model.ApplicantPerPage,
                                       SearchTerm = Model.SearchTerm,
                                       OfficeCode = Model.OfficeCode,
                                       IsPrinted = Model.IsPrinted,
                                       SelectedDate = Model.SelectedDate,
                                       FromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
                                       ToDate = Model.ToDate?.ToString("yyyy-MM-dd")
                                   })"class="page-link">

                            <i class="fa-solid fa-chevron-left me-1"></i>
                            Previous

                        </a>
                                }
                    else
                    {
                        <span class="page-link">
                            <i class="fa-solid fa-chevron-left me-1"></i>
                            Previous
                        </span>
                    }

                </li>

                <!-- Current Page -->
                <li class="page-item active">
                    <span class="page-link">
                        @Model.CurrentPageNumber
                    </span>
                </li>

                <!-- Next -->
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("CardPrintingGrid","Home",
                                   new
                                   {
                                       isSearch = true,
                                       CurrentPageNumber = Model.CurrentPageNumber + 1,
                                       ApplicantPerPage = Model.ApplicantPerPage,
                                       SearchTerm = Model.SearchTerm,
                                       OfficeCode = Model.OfficeCode,
                                       IsPrinted = Model.IsPrinted,
                                       SelectedDate = Model.SelectedDate,
                                       FromDate = Model.FromDate?.ToString("yyyy-MM-dd"),
                                       ToDate = Model.ToDate?.ToString("yyyy-MM-dd")
                                   })" class="page-link">

                            Next
                            <i class="fa-solid fa-chevron-right ms-1"></i>

                        </a>
                                }
                    else
                    {
                        <span class="page-link">
                            Next
                            <i class="fa-solid fa-chevron-right ms-1"></i>
                        </span>
                    }

                </li>

            </ul>
        </nav>

    </div>
}
@section Scripts {

    <script>
        const markPrintedUrl = '@Url.Action("MarkAsPrinted", "CardPrint")';

        const generateXmlUrl = '@Url.Action("GenerateEidXml", "XMLPrint")';
    </script>


    <script src="~/js/CardPrintingGrid.js"></script>
}