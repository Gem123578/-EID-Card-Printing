@model EIDCardPrint.Models.LoginViewModel
@{
    ViewData["Title"] = "Login Form";
}

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet' />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="~/css/Login.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="page-index-center">
    <div class="wrapper">
        <h1>Login</h1>

        @using (Html.BeginForm("Login", "Home", FormMethod.Post))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger small", style = "display:block;" })
            <div class="input-box">
                @Html.TextBoxFor(m => m.Name, new { placeholder = "Name" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small", style = "display:block" })
            </div>

            <div class="input-box">
                @Html.PasswordFor(m => m.Password, new { placeholder = "Password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small", style = "display:block" })
            </div>

            <form asp-action="IssuedCardForm" asp-controller="IssuedCard" method="GET">
                <button type="submit" class="btn">Login</button>
            </form>   
        }
    </div>
</div>
