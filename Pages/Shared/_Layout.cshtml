<!DOCTYPE html>
<html>
<head>
    <title>CardPrinting</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <link href="~/css/layout.css" rel="stylesheet">
</head>

<body>

    <div class="wrapper">

        <nav id="sidebar">

            <div class="logo">
                <img src="/images/EIDLogo.png" width="40" height="40" class="me-3" alt="Logo">
                <span>Card Printing <br> System</span>
            </div>

            <ul>

                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "CardPrintingGrid" ? "active" : "")"
                        asp-controller="Home" asp-action="CardPrintingGrid">
                        <i class="fa-solid fa-print"></i>
                        <span>Card Printing</span>
                    </a>
                </li>

                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "IssuedCardForm" ? "active" : "")"
                    asp-controller="IssuedCard" asp-action="IssuedCardForm">
                        <i class="fa-solid fa-address-card"></i>
                        <span>Issue Card</span>
                    </a>
                </li>

                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "ReceivedCard" ? "active" : "")"
                    asp-controller="IssuedCard" asp-action="ReceivedCard">
                        <i class="fa-solid fa-address-card"></i>
                        <span>Receiving Card</span>
                    </a>
                </li>

                <li>
                    <a class="@(ViewContext.RouteData.Values["Action"].ToString() == "Settings" ? "active" : "")"
                    asp-controller="IssuedCard" asp-action="ReceivedCard">
                        <i class="fa-solid fa-gear"></i>
                        <span>Settings</span>
                    </a>
                </li>

            </ul>

        </nav>

        <div class="content">

            <div class="topbar">

                <button id="menu-btn">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <h4>Card Printing System</h4>

                <div class="position-absolute top-0 end-0 m-3">
                    <button type="button"
                            id="logoutBtn"
                            data-logout-url="@Url.Action("Logout", "Home")"
                            class="btn btn-primary btn-lg rounded-pill px-3 shadow-sm fw-semibold">

                        <i class="fa-solid fa-right-from-bracket me-2"></i>
                        Logout

                    </button>
                </div>

                
            </div>

            <div class="container-fluid mt-4">

                @RenderBody()

        </div>
        
    </div>
    
</div>

    <div id="globalAlertModal" class="app-alert-backdrop" role="dialog" aria-modal="true">
        <div class="app-alert-card">

            <div class="app-alert-header">
                <div class="d-flex justify-content-center align-items-center">
                    <div class="app-alert-icon" id="globalAlertIcon"></div>
                    <h3 id="globalAlertTitle" class="app-alert-title">
                        Warning Message
                    </h3>
                </div>

                <button class="app-alert-close"
                        onclick="closeAppAlert()"
                        aria-label="Close">
                    &times;
                </button>
            </div>

            <div class="app-alert-body">
                <p id="globalAlertMessage" class="app-alert-message">

                </p>
            </div>

            <div class="app-alert-actions">
                <button id="globalAlertCancelBtn"
                        class="app-alert-btn app-alert-btn-cancel"
                        onclick="closeAppAlert()">
                    Cancel
                </button>

                <button id="globalAlertConfirmBtn"
                        class="app-alert-btn app-alert-btn-confirm">
                    OK
                </button>
            </div>

        </div>
    </div>

  

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/js/layout.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>